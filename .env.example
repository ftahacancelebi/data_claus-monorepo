# ──────────────────────────────────────────────────────────────────────────
# DataClaus monorepo — root environment template
# Copy to `.env` for local development.
#
# App-specific environments live next to each app:
#   - apps/dataclaus-nestjs-api/.env.example
#   - apps/dataclaus-web/.env.local.example  (if present)
#   - apps/tiktok-mobile/app.json             (Expo config)
# ──────────────────────────────────────────────────────────────────────────

# Demo seed credentials (used by scripts/demo-seed.ts and JURY_LOGIN.md)
DEMO_PASSWORD=demo1234

# Default ports — change only if there's a local conflict
API_PORT=3000
WEB_PORT=3001
TIKTOK_BACKEND_PORT=4001

# Postgres (mirrors apps/dataclaus-nestjs-api/.env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dataclaus

# Kafka (docker-compose.yaml uses these)
KAFKA_BROKERS=localhost:9092
