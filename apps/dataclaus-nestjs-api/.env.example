# ──────────────────────────────────────────────────────────────────────────
# DataClaus API — environment template
# Copy to `.env` and replace every "change-me" / "REPLACE" before deploying.
# ──────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000

# Database (Postgres)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=dataclaus
# Set to "false" in production — TypeORM migrations only
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# Auth — JWT
# Generate: `openssl rand -hex 32`
JWT_SECRET=change-me-min-32-chars-or-tokens-are-trivially-forgeable
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Ad slot/seal flow — HMAC signing
# Independent secret so rotation does not invalidate JWTs.
# Generate: `openssl rand -hex 32`
AD_SIGNING_SECRET=change-me-distinct-from-jwt-secret-min-32-chars

# Kafka (event streaming)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=dataclaus-api
KAFKA_TOPIC_RAW_DATA=ingest.raw_data
KAFKA_TOPIC_SCORED_EVENTS=ingest.scored_events

# reCAPTCHA Enterprise (bot detection on auth flows)
# Empty values disable enforcement (dev only).
RECAPTCHA_PROJECT_ID=
RECAPTCHA_SITE_KEY=
RECAPTCHA_API_KEY=

# Webhook delivery
WEBHOOK_DELIVERY_TIMEOUT_MS=5000
WEBHOOK_MAX_RETRIES=5

# Rate limiting (overrides ThrottlerModule defaults if set)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Observability — leave empty in dev
SENTRY_DSN=
LOG_LEVEL=debug
