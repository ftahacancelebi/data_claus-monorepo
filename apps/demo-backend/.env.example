# DataClaus Demo Backend Environment Variables
# Copy this to .env and fill in your values from the dashboard

# DataClaus API URL (Go API server)
DATACLAUS_API_URL=http://localhost:3000

# Your API Key from DataClaus Dashboard
# Go to: Dashboard > API Keys > Generate New Key
# The raw key is ALSO used as the HMAC secret
DATACLAUS_API_KEY=your_api_key_from_dashboard

# Your Developer UUID from the Dashboard
# This is shown after registration or in your profile
DEVELOPER_ID=your_developer_uuid

# Server port (optional, default 4000)
PORT=4000
