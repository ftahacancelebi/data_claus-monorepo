# DataClaus Demo Mobile App - Environment Variables
# =================================================
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Get your keys from Google Cloud Console:
#    - Go to: https://console.cloud.google.com/security/recaptcha
#    - Click "+ CREATE KEY"
#    - For iOS: Choose "iOS", enter bundle ID: com.dataclaus.demo
#    - For Android: Choose "Android", enter package: com.dataclaus.demo
#    - Copy the Site Key that appears (starts with 6L...)
# 3. Paste your keys below
# 4. Restart Expo

# Backend URL (your demo-backend server)
EXPO_PUBLIC_BACKEND_URL=http://localhost:4000

# =================================================
# PASTE YOUR GOOGLE CLOUD RECAPTCHA SITE KEYS HERE:
# =================================================

# iOS Site Key (from Google Cloud Console)
EXPO_PUBLIC_RECAPTCHA_SITE_KEY_IOS=6LcXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Android Site Key (from Google Cloud Console)
EXPO_PUBLIC_RECAPTCHA_SITE_KEY_ANDROID=6LcXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# =================================================
# DEMO MODE (set to 'true' to use without real keys)
# =================================================
EXPO_PUBLIC_RECAPTCHA_DEMO_MODE=true
