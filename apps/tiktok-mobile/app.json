{
  "expo": {
    "name": "TikTok Clone",
    "slug": "tiktok-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tiktok-clone",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dataclaus.tiktokclone"
    },
    "android": {
      "package": "com.dataclaus.tiktokclone"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
