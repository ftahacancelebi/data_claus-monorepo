{
  "name": "dataclaus-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/dataclaus-web/src",
  "projectType": "application",
  "targets": {
    "dev": {
      "command": "next dev --port 3001",
      "options": {
        "cwd": "apps/dataclaus-web"
      }
    },
    "build": {
      "command": "next build",
      "options": {
        "cwd": "apps/dataclaus-web"
      },
      "outputs": ["{projectRoot}/.next"]
    },
    "start": {
      "command": "next start --port 3001",
      "options": {
        "cwd": "apps/dataclaus-web"
      },
      "dependsOn": ["build"]
    },
    "lint": {
      "command": "next lint",
      "options": {
        "cwd": "apps/dataclaus-web"
      }
    }
  }
}
