{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "noImplicitAny": false,
    "useDefineForClassFields": false,
    "baseUrl": "..",
    "types": ["node"]
  },
  "include": ["./**/*.ts"],
  "ts-node": {
    "transpileOnly": true,
    "files": true
  }
}
